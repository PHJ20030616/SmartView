# =============================================================================
# SmartView 基础设施配置示例（复制为 .env 后按需修改；.env 不应提交到仓库）
# -----------------------------------------------------------------------------
# 说明：这里是占位示例值；正式 .env 中的密码必须与 docker-compose 启动的
# 基础设施实际初始化值一致，否则各后端连接会被拒绝。
# =============================================================================

# docker-compose 项目名：用于隔离命名空间与容器前缀
COMPOSE_PROJECT_NAME=smartview-infra
# 容器内时区
TZ=Asia/Shanghai

# -----------------------------------------------------------------------------
# MySQL
# -----------------------------------------------------------------------------
# MySQL 主机地址（本地开发用 localhost，容器间联通用服务名）
MYSQL_HOST=localhost
# MySQL 服务端口
MYSQL_PORT=3306
# 业务数据库名：docker-compose 首次初始化时由镜像自动创建
MYSQL_DATABASE=smartview
# root 账号密码：docker-compose 首次初始化 MySQL 数据卷时生效，Spring Boot 用它连接
MYSQL_ROOT_PASSWORD=smartview_root_password
# Spring Boot 数据源 JDBC 连接串：修改 MYSQL_HOST/PORT/DATABASE 后需同步更新
MYSQL_JDBC_URL=jdbc:mysql://localhost:3306/smartview?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
# Python 后端（smartview-ai）读取已确认简历画像所用的账号：
# 示例沿用 Spring 的 root 复用方案；如需独立应用账号，可将 docker-compose 中
# 注释掉的 MYSQL_USER/MYSQL_PASSWORD 放开并重建数据卷，再把下面两行改为该账号。
MYSQL_USERNAME=root
MYSQL_PASSWORD=smartview_root_password

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Redis 主机地址
REDIS_HOST=localhost
# Redis 服务端口
REDIS_PORT=6379
# Redis 访问密码（docker-compose 以 --requirepass 生效）
REDIS_PASSWORD=smartview_redis_password
# 便捷连接串（仅作参考，应用侧使用上面的拆分字段）
REDIS_URL=redis://:smartview_redis_password@localhost:6379/0

# -----------------------------------------------------------------------------
# RabbitMQ
# -----------------------------------------------------------------------------
# RabbitMQ 主机地址
RABBITMQ_HOST=localhost
# AMQP 协议端口（管理台端口见 RABBITMQ_MANAGEMENT_PORT）
RABBITMQ_AMQP_PORT=5672
# RabbitMQ 管理台 Web 端口
RABBITMQ_MANAGEMENT_PORT=15672
# 默认用户：Spring Boot 与 Python worker 均用该账号连接 broker
RABBITMQ_DEFAULT_USER=smartview
# 默认用户密码
RABBITMQ_DEFAULT_PASS=smartview_rabbitmq_password
# 默认虚拟主机
RABBITMQ_DEFAULT_VHOST=smartview
# AMQP 便捷连接串：需与上方拆分字段保持一致
RABBITMQ_AMQP_URL=amqp://smartview:smartview_rabbitmq_password@localhost:5672/smartview
# RabbitMQ 管理台地址
RABBITMQ_MANAGEMENT_URL=http://localhost:15672

# -----------------------------------------------------------------------------
# MinIO（对象存储，存放简历 PDF 等文件）
# -----------------------------------------------------------------------------
# MinIO 主机地址
MINIO_HOST=localhost
# MinIO S3 API 端口
MINIO_API_PORT=9000
# MinIO 控制台 Web 端口
MINIO_CONSOLE_PORT=9001
# MinIO root 用户
MINIO_ROOT_USER=smartview
# MinIO root 密码
MINIO_ROOT_PASSWORD=smartview_minio_password
# S3 兼容端点地址（Spring 侧 smartview.minio.endpoint 使用）
MINIO_ENDPOINT=http://localhost:9000
# MinIO 控制台地址
MINIO_CONSOLE_URL=http://localhost:9001
# MinIO region（默认 us-east-1）
MINIO_REGION=us-east-1

# -----------------------------------------------------------------------------
# Chroma（向量库服务地址；当前 Python 使用本地持久化目录，见 smartview-ai/.env）
# -----------------------------------------------------------------------------
# Chroma 主机地址
CHROMA_HOST=localhost
# Chroma 服务端口
CHROMA_PORT=8001
# Chroma 服务地址
CHROMA_URL=http://localhost:8001

# -----------------------------------------------------------------------------
# 应用级共享密钥
# -----------------------------------------------------------------------------
# JWT 签名密钥：Spring Boot 生成/校验 token 使用，强度不足时应用启动失败
JWT_SECRET=replace-with-a-long-random-secret
# AI 服务（FastAPI）鉴权密钥：Spring Boot 调用 FastAPI 时放入请求头，
# 值需与 FastAPI 端校验的 AI_SERVICE_API_KEY 保持一致
AI_SERVICE_API_KEY=change-me
