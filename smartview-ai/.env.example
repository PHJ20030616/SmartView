# =============================================================================
# SmartView AI（FastAPI）专属配置示例（复制为 .env 后按需修改；.env 不提交仓库）
# -----------------------------------------------------------------------------
# 连接外部服务的账号密码与 base URL 一律放在仓库根的 smartview-infra/.env，
# 由本服务启动时自动读取（见 app/core/config.py 的 _load_shared_infra_env）。
# 本文件只保留 Python 后端独有、其他服务不需要关心的字段。
# =============================================================================

# 运行环境：local / dev / prod，供日志级别与降级策略等分支使用
SMARTVIEW_AI_ENV=local

# -----------------------------------------------------------------------------
# 日志配置
# -----------------------------------------------------------------------------
# 日志级别
LOG_LEVEL=INFO
# LOG_FILE_ENABLED=false 时仅输出控制台
LOG_FILE_ENABLED=true
# 日志文件目录（相对 smartview-ai 运行目录）
LOG_DIR=./logs
# 单个日志文件大小上限（字节），超过后滚动
LOG_FILE_MAX_BYTES=52428800
# 保留的滚动日志文件个数
LOG_FILE_BACKUP_COUNT=7

# -----------------------------------------------------------------------------
# DeepSeek（大模型推理，仅 Python 后端调用）
# -----------------------------------------------------------------------------
# DeepSeek API 密钥
DEEPSEEK_API_KEY=
# OpenAI 兼容接口 base URL
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 使用的模型名
DEEPSEEK_MODEL=deepseek-v4-flash
# 单次请求超时（秒）
DEEPSEEK_TIMEOUT_SECONDS=60
# 单次输出上限 token：DeepSeek V4 Flash 上限 8K，超过会被接口直接以 400 拒绝
DEEPSEEK_MAX_TOKENS=8192
# 采样温度，越低输出越稳定
DEEPSEEK_TEMPERATURE=0.1
# 输入文本截断上限（字符），防止超大上下文
DEEPSEEK_MAX_INPUT_CHARACTERS=60000

# -----------------------------------------------------------------------------
# Qwen 文本向量模型（Embedding，仅 Python 后端调用）
# 替换 Chroma 默认的英文 all-MiniLM-L6-v2，中文检索效果更好。
# 文档入库与查询共用同一模型，保证向量维度一致（qwen3.7-text-embedding 为 1024 维）。
# -----------------------------------------------------------------------------
# Qwen 向量模型 API 密钥
QWEN_EMBEDDING_API_KEY=
# OpenAI 兼容接口 base URL
QWEN_EMBEDDING_BASE_URL=
# 使用的模型名
QWEN_EMBEDDING_MODEL=qwen3.7-text-embedding

# -----------------------------------------------------------------------------
# 简历 PDF 与 OCR 处理限制（防止超大文件/超大页消耗过多内存与 CPU）
# -----------------------------------------------------------------------------
# 简历文件大小上限（字节）
RESUME_MAX_FILE_BYTES=10485760
# PDF 最大解析页数
RESUME_MAX_PAGES=20
# OCR 渲染 DPI
RESUME_OCR_DPI=200
# 单页有效字符低于该值视为无用页
RESUME_MIN_USEFUL_PAGE_CHARACTERS=20
# 单页最大边长（像素），防止超大图片
RESUME_MAX_PAGE_DIMENSION=10000
# 单页最大像素数
RESUME_MAX_PAGE_PIXELS=25000000
# 允许下载简历的 MinIO/S3 来源白名单：必须与 Spring 的 MINIO_ENDPOINT 主机一致，
# 本地默认 MinIO 用 localhost；生产请改为实际域名，不能留空或放宽为任意内网地址
RESUME_ALLOWED_ORIGINS=["http://localhost:9000"]
# 简历下载最大重定向次数
RESUME_MAX_REDIRECTS=3
# 简历下载超时（秒）
RESUME_DOWNLOAD_TIMEOUT_SECONDS=60

# -----------------------------------------------------------------------------
# RabbitMQ 拓扑与消费参数（broker 地址与账号见 smartview-infra/.env）
# 队列名/路由键必须与 MQ 契约（contracts/mq/）及 Spring Boot 生产者保持一致
# -----------------------------------------------------------------------------
# 交换机名
RABBITMQ_EXCHANGE=smartview.direct
# 简历解析任务队列
RABBITMQ_RESUME_PARSE_QUEUE=smartview.resume.parse
# 简历解析任务路由键
RABBITMQ_RESUME_PARSE_ROUTING_KEY=resume.parse.task
# 简历解析结果回执路由键
RABBITMQ_RESUME_RESULT_ROUTING_KEY=resume.parse.result
# 简历向量化任务队列
RABBITMQ_RESUME_VECTORIZE_QUEUE=smartview.resume.vectorize.v1
# 简历向量化任务路由键
RABBITMQ_RESUME_VECTORIZE_ROUTING_KEY=resume.vectorize.task
# 死信交换机（消费失败投递到死信队列）
RABBITMQ_DEAD_LETTER_EXCHANGE=smartview.dlx
# 向量化死信队列
RABBITMQ_RESUME_VECTORIZE_DEAD_LETTER_QUEUE=smartview.resume.vectorize.dlq
# 向量化死信路由键
RABBITMQ_RESUME_VECTORIZE_DEAD_LETTER_ROUTING_KEY=resume.vectorize.task.dlq
# 向量化结果回执路由键
RABBITMQ_RESUME_VECTORIZE_RESULT_ROUTING_KEY=resume.vectorize.result
# 消息最大重试次数（消费失败后重投）
RABBITMQ_TASK_MAX_RETRIES=3
# 重试基础延迟（秒），按 2^retryCount 指数退避
RABBITMQ_RETRY_DELAY_SECONDS=1
# broker 断线重连间隔（秒）
RABBITMQ_RECONNECT_DELAY_SECONDS=5
# 单消费者预取数量（未确认消息上限）
RABBITMQ_PREFETCH_COUNT=1

# -----------------------------------------------------------------------------
# 简历向量化：worker 从 MySQL 读取已确认画像（凭据见 smartview-infra/.env）
# 写入 Chroma（默认连接 Docker 部署的 Chroma server，见 smartview-infra/docker-compose.yml）
# -----------------------------------------------------------------------------
# Chroma 连接模式：http=连接 Docker Chroma server（默认）；persistent=本地嵌入式目录。
# 默认走 http 是为了让 Python 后端与 Walnut UI 等外部工具观察同一份向量数据。
CHROMA_MODE=http
# Chroma server 地址（CHROMA_MODE=http 时生效）
CHROMA_HOST=localhost
# Chroma server 端口（docker-compose 映射到宿主机的端口）
CHROMA_PORT=8001
# 是否使用 HTTPS 连接 Chroma server（CHROMA_MODE=http 时生效）
CHROMA_SSL=false
# 本地 Chroma 持久化目录（仅 CHROMA_MODE=persistent 时使用，相对 smartview-ai 运行目录）
# 注意：默认 http 模式下该目录中的历史数据不会被读取；如需保留请重灌到 Docker server
# （python -m scripts.ingest_knowledge --root ../knowledge --strategy upsert），
# 确认数据迁移完成后可直接删除该目录。
CHROMA_PERSIST_DIRECTORY=./data/chroma
# 简历画像切片 collection 名
CHROMA_COLLECTION_NAME=resume_profile_chunks
# 知识库离线入库：八股 collection（与入库脚本、检索器保持一致）
CHROMA_KNOWLEDGE_COLLECTION_NAME=interview_knowledge_base
# 知识库离线入库：面经 collection
CHROMA_EXPERIENCE_COLLECTION_NAME=interview_experience_cases
# 简历向量切片字符上限
RESUME_VECTOR_CHUNK_SIZE=800
# 简历向量切片重叠字符数
RESUME_VECTOR_CHUNK_OVERLAP=120
