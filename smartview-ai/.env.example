# 日志配置：LOG_FILE_ENABLED=false 时仅输出控制台；LOG_DIR 相对 smartview-ai 运行目录
LOG_LEVEL=INFO
LOG_FILE_ENABLED=true
LOG_DIR=./logs
LOG_FILE_MAX_BYTES=52428800
LOG_FILE_BACKUP_COUNT=7

# FastAPI 服务间调用鉴权
AI_SERVICE_API_KEY=

# DeepSeek OpenAI 兼容接口配置
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_TEMPERATURE=0.1
DEEPSEEK_MAX_INPUT_CHARACTERS=60000

# 简历 PDF 与 OCR 处理限制
RESUME_MAX_FILE_BYTES=10485760
RESUME_MAX_PAGES=20
RESUME_OCR_DPI=200
RESUME_MIN_USEFUL_PAGE_CHARACTERS=20
RESUME_MAX_PAGE_DIMENSION=10000
RESUME_MAX_PAGE_PIXELS=25000000
# 必须与 Spring 的 MINIO_ENDPOINT 主机一致；本地默认 MinIO 使用 localhost，
# 生产环境请改为实际的 MinIO/S3 域名，不能留空或放宽为任意内网地址。
RESUME_ALLOWED_ORIGINS=["http://localhost:9000"]
RESUME_MAX_REDIRECTS=3
RESUME_DOWNLOAD_TIMEOUT_SECONDS=60

# RabbitMQ：必须与 Spring Boot 使用同一交换机、账号和虚拟主机
RABBITMQ_HOST=localhost
RABBITMQ_AMQP_PORT=5672
RABBITMQ_DEFAULT_USER=smartview
RABBITMQ_DEFAULT_PASS=123456
RABBITMQ_DEFAULT_VHOST=smartview
RABBITMQ_EXCHANGE=smartview.direct
RABBITMQ_RESUME_PARSE_QUEUE=smartview.resume.parse
RABBITMQ_RESUME_PARSE_ROUTING_KEY=resume.parse.task
RABBITMQ_RESUME_RESULT_ROUTING_KEY=resume.parse.result
RABBITMQ_RESUME_VECTORIZE_QUEUE=smartview.resume.vectorize.v1
RABBITMQ_RESUME_VECTORIZE_ROUTING_KEY=resume.vectorize.task
RABBITMQ_DEAD_LETTER_EXCHANGE=smartview.dlx
RABBITMQ_RESUME_VECTORIZE_DEAD_LETTER_QUEUE=smartview.resume.vectorize.dlq
RABBITMQ_RESUME_VECTORIZE_DEAD_LETTER_ROUTING_KEY=resume.vectorize.task.dlq
RABBITMQ_RESUME_VECTORIZE_RESULT_ROUTING_KEY=resume.vectorize.result
RABBITMQ_TASK_MAX_RETRIES=3
RABBITMQ_RETRY_DELAY_SECONDS=1
RABBITMQ_RECONNECT_DELAY_SECONDS=5
RABBITMQ_PREFETCH_COUNT=1

# 向量入库依赖：Worker 从 MySQL 读取已确认画像并写入本地 Chroma
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=smartview
MYSQL_USERNAME=smartview
MYSQL_PASSWORD=123456
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=resume_profile_chunks
RESUME_VECTOR_CHUNK_SIZE=800
RESUME_VECTOR_CHUNK_OVERLAP=120
